; Frontline M0 render spike (SYSTEM_DESIGN.md §2.2 gate 7, §4.1, §15 M0).
; Godot 4.7.2, Forward+ by default. Run `--rendering-method mobile` for the
; Mobile A/B. The Rust GDExtension is in ../crates/godot-bridge.

config_version=5

[application]

config/name="Frontline M0 Render Spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
; 4096: the two parallel splits share this atlas, so 2048 would give each
; split only part of a 2048 map (§2.2 asks for 2 x 2048).
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[threading]

; §2.2 / §4.1 rule 7: the Deck caps Godot's worker pool at 2. Applies to
; exports with the custom feature tag "deck"; tools/render_bench.sh --preset
; deck applies it on desktop through a temporary override.cfg.
worker_pool/max_threads.deck=2
