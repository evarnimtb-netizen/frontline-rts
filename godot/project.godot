; Frontline (S1 skirmish slice; docs/slices/S1-skirmish.md). Boots to the
; main menu. The M0 render spike stays in main.tscn, driven by bench.tscn
; (SYSTEM_DESIGN.md §2.2 gate 7, §4.1, §15 M0).
; Godot 4.7.2, Forward+ by default. Run `--rendering-method mobile` for the
; Mobile A/B. The Rust GDExtension is in ../crates/godot-bridge.

config_version=5

[application]

config/name="Frontline"
run/main_scene="res://ui/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; Order matters: AudioManager creates the buses Settings applies volumes to.
AudioManager="*res://autoload/audio_manager.gd"
Settings="*res://autoload/settings.gd"
Session="*res://autoload/session.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; UI is laid out for 1600x900 and scales with the window (800p on the Deck).
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/frontline_theme.tres"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
; 4096: the two parallel splits share this atlas, so 2048 would give each
; split only part of a 2048 map (§2.2 asks for 2 x 2048).
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[threading]

; §2.2 / §4.1 rule 7: the Deck caps Godot's worker pool at 2. Applies to
; exports with the custom feature tag "deck"; tools/render_bench.sh --preset
; deck applies it on desktop through a temporary override.cfg.
worker_pool/max_threads.deck=2
