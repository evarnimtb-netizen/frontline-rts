[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menu/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://ui/menu/menu_backdrop.gd" id="2_backdrop"]

[sub_resource type="ButtonGroup" id="ButtonGroup_nav"]
allow_unpress = false

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_backdrop")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
