[gd_resource type="Theme" format=3]

; Frontline UI theme (S1). Flat dark panels, warm off-white text, one brass
; accent for focus and primary actions. Colours mirror ui/palette.gd.
; Type variations: TitleLabel, HeaderLabel, DimLabel, HudPanel, CardPanel,
; PrimaryButton, HudButton.

[ext_resource type="FontFile" path="res://ui/fonts/Barlow-Medium.ttf" id="1_body"]
[ext_resource type="FontFile" path="res://ui/fonts/Barlow-SemiBold.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://ui/fonts/BarlowCondensed-SemiBold.ttf" id="3_cond"]

